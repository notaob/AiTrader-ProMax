# AiTrader 部署环境变量
# 复制此文件为 .env 并修改敏感配置: cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=123456

# Redis
REDIS_PASSWORD=123456

# JWT
JWT_SECRET=your-very-long-and-secure-secret-key-here-with-at-least-32-charact

# AI (DashScope)
AI_API_KEY=your_dashscope_api_key_here
AI_MODEL=qwen3-max
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=deepseek-v4-flash

# Resend (邮件验证码)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@resend.dev
